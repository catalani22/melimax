# Mercado Livre (developers.mercadolivre.com.br)
ML_APP_ID=seu_app_id_aqui
ML_CLIENT_SECRET=seu_client_secret_aqui
# Precisa ser exatamente a URL cadastrada no app do Mercado Livre
ML_REDIRECT_URI=http://localhost:3001/api/auth/callback

# URLs publicas (sem barra no final)
FRONTEND_URL=http://localhost:5173
# Opcional: usado apenas para montar o redirect quando ML_REDIRECT_URI nao for definido
BACKEND_URL=http://localhost:3001
# Opcional: origens extras permitidas no CORS, separadas por virgula
CORS_ORIGIN=

# Banco de dados (Neon/Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ml_dropshipping

# Tipo de anuncio criado por padrao: free | bronze | silver | gold_special
ML_LISTING_TYPE=gold_special

# Senha de acesso ao painel. Se vazia, o painel fica sem protecao.
DASHBOARD_PASSWORD=troque_por_uma_senha_forte

PORT=3001
NODE_ENV=development
